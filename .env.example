# ==============================================================================
# QuizFast AI (リアルタイム・クイズ高速回答 Webアプリケーション)
# 環境変数設定テンプレート (.env.example)
#
# 【注意】
# 本ファイルをコピーして `.env` を作成し、実際の値を設定してください。
# `.env` にはAPIキー等の機密情報が含まれるため、絶対にGitにコミットしないでください。
# ==============================================================================

# [必須] Google Gemini API Key
# Google AI Studio (https://aistudio.google.com/) から発行したAPIキーを設定してください。
GEMINI_API_KEY=your_gemini_api_key_here

# [任意] 使用するGeminiモデル名（デフォルト: gemini-3.5-flash-lite）
# 超高スループット・最速かつ高精度な gemini-3.5-flash-lite を推奨します。
GEMINI_MODEL=gemini-3.5-flash-lite

# [任意] サーバー起動ポート（デフォルト: 3055）
# 自宅Ubuntu Serverなどの既存サービスと競合しない独立したポート番号を指定します。
PORT=3055

# [任意] 実行環境指定 (development | production)
NODE_ENV=production
